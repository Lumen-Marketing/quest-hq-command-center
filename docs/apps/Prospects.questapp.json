        "id": "a-bid",
        "name": "Something to bid — promote them",
        "trigger": { "event": "field_is", "fieldId": "f-bid", "value": true },
        "actions": [
          {
            "type": "notify",
            "message": "This prospect has something to bid. Promote them to Leads, where the estimate attaches — one lead per trade per address."
          }
        ]
      },
      {
        "id": "a-quiet",
        "name": "Gone quiet — decide, do not drift",
        "trigger": { "event": "stage_moves", "fieldId": "f-status", "to": "ps-quiet" },
        "actions": [
          {
            "type": "notify",
            "message": "Gone quiet. Either send them to Nurturing with a day it rings on, or mark Do not contact — a prospect left drifting is a drip nobody is working."
          }
        ]
