    "automations": [
      {
        "id": "a-new",
        "name": "New student — collect documents",
        "trigger": {
          "event": "created"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A new student was added. Collect the enrollment documents and assign a homeroom teacher."
          }
        ]
      },
      {
        "id": "a-attendance",
        "name": "Attendance below 90% — follow up",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-rate",
          "op": "<",
          "value": "90"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A student's attendance has dropped below 90%. The homeroom teacher should contact the family."
          }
        ]
      },
      {
        "id": "a-withdrawn",
        "name": "Withdrawn — close the record",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "ss-withdrawn"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A student was withdrawn. Settle any fees, return records requested by the new school, and note the reason."
          }
        ]
      }
    ],
