    "automations": [
      {
        "id": "a-full",
        "name": "Course full — close enrollment",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-seats",
          "op": "<=",
          "value": "0"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A course is full. Close enrollment or open another section, and start a waiting list."
          }
        ]
      },
      {
        "id": "a-session",
        "name": "In session — share the syllabus",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "cr-session"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A course has started. Make sure the syllabus is uploaded and shared with students and families."
          }
        ]
      },
      {
        "id": "a-complete",
        "name": "Completed — enter final grades",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "cr-complete"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A course has finished. Enter final grades in the Gradebook before report cards go out."
          }
        ]
