    "automations": [
      {
        "id": "a-overdue",
        "name": "Overdue — send a reminder",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "fe-overdue"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-reminders",
            "value": "+1"
          },
          {
            "type": "notify",
            "message": "A fee invoice is overdue. Send a friendly reminder, and offer a payment plan if the family is struggling."
          }
        ]
      },
      {
        "id": "a-plan",
        "name": "Payment plan — write down the terms",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "fe-plan"
        },
        "actions": [
