    "automations": [
      {
        "id": "a-urgent",
        "name": "Urgent — respond today",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-priority",
          "value": "pr-urgent"
        },
        "actions": [
          {
            "type": "notify",
            "message": "An urgent message from a family came in. Respond today, and involve school leadership if a child's safety is concerned."
          }
        ]
      },
      {
        "id": "a-wellbeing",
        "name": "Wellbeing — keep it confidential",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-topic",
          "value": "tp-wellbeing"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-confidential",
            "value": true
          },
          {
            "type": "notify",
            "message": "A wellbeing conversation was logged and marked confidential. Share it with the counselor, and only with staff who need to know."
          }
        ]
      },
      {
        "id": "a-resolved",
        "name": "Resolved — record the outcome",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "pc-resolved"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A conversation with a family was resolved. Write down what was agreed in Outcome."
          }
        ]
      }
    ],
