    "automations": [
      {
        "id": "a-up-d",
        "name": "Final % reaches 60 — D",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-final",
          "op": ">=",
          "value": "60"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-letter",
            "value": "lg-d"
          }
        ]
      },
      {
        "id": "a-up-c",
        "name": "Final % reaches 70 — C",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-final",
          "op": ">=",
          "value": "70"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-letter",
            "value": "lg-c"
          }
        ]
      },
      {
        "id": "a-up-b",
        "name": "Final % reaches 80 — B",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-final",
          "op": ">=",
          "value": "80"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-letter",
            "value": "lg-b"
          }
        ]
      },
      {
        "id": "a-up-a",
        "name": "Final % reaches 90 — A",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-final",
          "op": ">=",
          "value": "90"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-letter",
            "value": "lg-a"
          }
        ]
      },
      {
        "id": "a-down-b",
        "name": "Final % falls below 90 — B",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-final",
          "op": "<",
          "value": "90"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-letter",
            "value": "lg-b"
          }
        ]
      },
      {
        "id": "a-down-c",
        "name": "Final % falls below 80 — C",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-final",
          "op": "<",
          "value": "80"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-letter",
            "value": "lg-c"
          }
        ]
      },
      {
        "id": "a-down-d",
        "name": "Final % falls below 70 — D",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-final",
          "op": "<",
          "value": "70"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-letter",
            "value": "lg-d"
          }
        ]
      },
      {
        "id": "a-down-f",
        "name": "Final % falls below 60 — F and intervention",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-final",
          "op": "<",
          "value": "60"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-letter",
            "value": "lg-f"
          },
          {
            "type": "set_field",
            "fieldId": "f-status",
            "value": "gb-intervention"
          },
          {
            "type": "notify",
            "message": "A student's final grade is below 60%. Talk to the student and their family, and agree a support plan."
          }
        ]
      },
      {
        "id": "a-published",
        "name": "Published — families can see it",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "gb-published"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A grade report was published. Upload the report card so families and staff see the same thing."
          }
        ]
      }
    ],
