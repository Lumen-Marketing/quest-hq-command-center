    "automations": [
      {
        "id": "a-collecting",
        "name": "Past due — chase missing work",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "as-collecting"
        },
        "actions": [
          {
            "type": "notify",
            "message": "An assignment is past its due date. Check Missing, remind those students and contact their families."
          }
        ]
      },
      {
        "id": "a-grading",
        "name": "Grading — aim to return within a week",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "as-grading"
        },
        "actions": [
          {
            "type": "notify",
            "message": "An assignment is being graded. Aim to return feedback to students within a week."
