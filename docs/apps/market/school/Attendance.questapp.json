    "automations": [
      {
        "id": "a-unexcused",
        "name": "Unexcused absence — contact the family",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-unexcused",
          "op": ">",
          "value": "0"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-status",
            "value": "rg-followup"
          },
          {
            "type": "notify",
            "message": "A register has unexcused absences. Contact each family today and record it in the Absences list."
          }
        ]
      },
      {
        "id": "a-low",
        "name": "Attendance below 85%",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-rate",
          "op": "<",
          "value": "85"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A class had attendance below 85%. Check whether something is going on — illness, an event, or a pattern."
          }
        ]
      }
