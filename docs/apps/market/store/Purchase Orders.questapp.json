            "type": "notify",
            "message": "Only part of this order arrived. Fill in Received on each line and get a date for the rest from the supplier."
          }
        ]
      },
      {
        "id": "a-received",
        "name": "Received — update the shelves",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "os-received"
        },
        "actions": [
          {
            "type": "notify",
            "message": "An order was received. Update stock on each product, then file the invoice for payment."
          }
        ]
      },
