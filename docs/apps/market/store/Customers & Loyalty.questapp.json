    "automations": [
      {
        "id": "a-silver",
        "name": "Spend reaches 500 — Silver",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-spend",
          "op": ">=",
          "value": "500"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-tier",
            "value": "tr-silver"
          }
        ]
      },
      {
        "id": "a-gold",
        "name": "Spend reaches 1,000 — Gold",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-spend",
          "op": ">=",
          "value": "1000"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-tier",
            "value": "tr-gold"
          }
        ]
      },
      {
        "id": "a-vip",
        "name": "Spend reaches 2,500 — VIP",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-spend",
          "op": ">=",
          "value": "2500"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-tier",
            "value": "tr-vip"
          },
          {
            "type": "notify",
            "message": "A customer has passed 2,500 in spend and is now VIP. Worth a thank-you and an invitation to the next preview evening."
          }
        ]
      },
      {
        "id": "a-lapsed",
        "name": "Lapsed — win them back",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "cu-lapsed"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A regular has lapsed. Send them their points balance and an offer while they still remember the store."
          }
        ]
      }
