        "config": {
          "currency": "$",
          "placeholder": ""
        }
      },
      {
        "id": "f-vstarget",
        "label": "Against target",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Revenue} - {Revenue target}) * {Revenue target} / {Revenue target}"
        }
      },
