      {
        "id": "f-profit",
        "label": "Gross profit",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Revenue} - {Cost of goods}"
        }
      },
      {
        "id": "f-margin",
        "label": "Margin %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Revenue} - {Cost of goods}) * 100 / {Revenue}"
        }
      },
      {
        "id": "f-perunit",
        "label": "Discount per unit",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Discount given} / {Units sold}"
        }
      },
