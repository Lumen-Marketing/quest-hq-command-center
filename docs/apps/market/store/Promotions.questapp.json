    "automations": [
      {
        "id": "a-live",
        "name": "Live — check the tills",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "pr-live"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A promotion is live. Ring one through to check the till takes the offer, and make sure the shelf edges match."
          }
        ]
      },
      {
        "id": "a-ended",
        "name": "Ended — take the signage down",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "pr-ended"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A promotion ended. Put prices back, take the signage down, and record units, revenue and discount given while they are to hand."
          }
        ]
      },
      {
        "id": "a-undertarget",
        "name": "Behind target",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-vstarget",
          "op": "<",
          "value": "0"
        },
        "actions": [
          {
            "type": "notify",
            "message": "This promotion is behind its revenue target. Decide whether to push it harder, change the offer, or let it end."
          }
        ]
      }
