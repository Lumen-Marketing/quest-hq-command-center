    "automations": [
      {
        "id": "a-approved",
        "name": "Approved — refund and restock",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "rs-approved"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A return was approved. Process the refund, then say whether the item went back on the shelf or was written off."
          }
        ]
      },
      {
        "id": "a-declined",
        "name": "Declined — explain it face to face",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "rs-declined"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A return was declined. Explain why to the customer and write the reason down here."
          }
        ]
      },
      {
        "id": "a-notresellable",
        "name": "Not resellable — claim or write it off",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-condition",
          "value": "cd-notresellable"
        },
        "actions": [
          {
            "type": "notify",
            "message": "This item cannot go back on the shelf. Claim it from the supplier if it was faulty, otherwise write it off in the next stock count."
          }
        ]
      }
