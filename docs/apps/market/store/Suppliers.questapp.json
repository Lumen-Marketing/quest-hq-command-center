    "automations": [
      {
        "id": "a-late",
        "name": "Third late delivery — review them",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-late",
          "op": ">=",
          "value": "3"
        },
        "actions": [
          {
            "type": "notify",
            "message": "This supplier has been late three times. Review the account with the rep, or move the lines to a second source."
          }
        ]
      },
      {
        "id": "a-hold",
        "name": "On hold — do not order",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "sp-hold"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A supplier was put on hold. Check for open purchase orders with them and find another source for anything urgent."
          }
        ]
      },
      {
        "id": "a-preferred",
        "name": "Preferred — agree the terms",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "sp-preferred"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A supplier is now preferred. Make sure the trade discount and payment terms here match what was agreed."
          }
        ]
      }
