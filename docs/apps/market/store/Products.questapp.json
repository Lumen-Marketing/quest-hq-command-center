      {
        "id": "f-cost",
        "label": "Cost price",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": "What you pay per unit"
        }
      },
      {
        "id": "f-retail",
        "label": "Retail price",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": "What the customer pays"
        }
      },
      {
        "id": "f-profit",
        "label": "Profit per unit",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Retail price} - {Cost price}"
        }
      },
      {
        "id": "f-margin",
        "label": "Margin %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Retail price} - {Cost price}) * 100 / {Retail price}"
        }
      },
      {
        "id": "f-markup",
        "label": "Markup %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Retail price} - {Cost price}) * 100 / {Cost price}"
        }
      },
      {
        "id": "f-stock",
        "label": "In stock",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": {
          "unit": "units"
        }
      },
      {
        "id": "f-reserved",
        "label": "Reserved",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": {
          "unit": "units",
          "placeholder": "Held for orders not yet collected"
        }
      },
      {
        "id": "f-available",
        "label": "Available to sell",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{In stock} - {Reserved}"
        }
      },
      {
        "id": "f-reorder",
        "label": "Reorder point",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": {
          "unit": "units"
        }
      },
      {
        "id": "f-reorderqty",
        "label": "Reorder quantity",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": {
          "unit": "units"
        }
      },
      {
        "id": "f-headroom",
        "label": "Above reorder point",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({In stock} - {Reorder point}) * {In stock} / {In stock}"
        }
      },
      {
        "id": "f-stockvalue",
        "label": "Stock at cost",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{In stock} * {Cost price}"
        }
      },
      {
        "id": "f-retailvalue",
        "label": "Stock at retail",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{In stock} * {Retail price}"
        }
      },
