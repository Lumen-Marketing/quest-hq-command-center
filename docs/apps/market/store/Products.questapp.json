    "automations": [
      {
        "id": "a-low",
        "name": "Below the reorder point — low stock",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-headroom",
          "op": "<",
          "value": "0"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-status",
            "value": "ps-low"
          },
          {
            "type": "notify",
            "message": "A product has fallen below its reorder point. Add it to the next purchase order."
          }
        ]
      },
      {
        "id": "a-out",
        "name": "Nothing left — out of stock",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-stock",
          "op": "<=",
          "value": "0"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-status",
            "value": "ps-out"
          },
          {
            "type": "notify",
            "message": "A product is out of stock. Order it, and take it off the shelf edge and the website."
          }
        ]
      }
    ],
