        "label": "Total takings",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Cash takings} + {Card takings} + {Mobile wallet takings} + {Gift card takings} + {Other takings}"
        }
      },
      {
        "id": "f-payouts",
