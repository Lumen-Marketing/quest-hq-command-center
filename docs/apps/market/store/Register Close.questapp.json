      {
        "id": "f-deposit",
        "label": "Banked",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": ""
        }
      },
      {
        "id": "f-expected",
        "label": "Cash expected",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Opening float} + {Cash takings} - {Paid out of the till} - {Banked}"
        }
      },
      {
        "id": "f-counted",
        "label": "Cash counted",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": "What was actually in the drawer"
        }
      },
      {
        "id": "f-overshort",
        "label": "Over or short",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Cash counted} - {Opening float} - {Cash takings} + {Paid out of the till} + {Banked}) * {Cash counted} / {Cash counted}"
        }
      },
      {
        "id": "f-refunds",
