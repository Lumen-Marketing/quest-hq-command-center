    "automations": [
      {
        "id": "a-short",
        "name": "Drawer is short",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-overshort",
          "op": "<",
          "value": "0"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-status",
            "value": "cl-short"
          },
          {
            "type": "notify",
            "message": "The drawer counted short. Recount, check for a missed payout or a wrong change, and tell the manager before leaving."
          }
        ]
      },
      {
        "id": "a-over",
        "name": "Drawer is over",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-overshort",
          "op": ">",
          "value": "0"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-status",
            "value": "cl-over"
          },
          {
            "type": "notify",
            "message": "The drawer counted over. Recount and check whether a sale was rung up wrong."
          }
        ]
      },
      {
        "id": "a-reviewed",
        "name": "Reviewed — file the day",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "cl-reviewed"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A register close was reviewed. Make sure the banking matches and the day is filed."
          }
        ]
      }
