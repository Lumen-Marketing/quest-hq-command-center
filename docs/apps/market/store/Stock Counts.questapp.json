      },
      {
        "id": "f-valuevariance",
        "label": "Value variance",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Value counted} - {Value expected}) * {Value counted} / {Value counted}"
        }
      },
      {
        "id": "f-shrinkage",
        "label": "Shrinkage %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Value expected} - {Value counted}) * 100 / {Value expected}"
        }
