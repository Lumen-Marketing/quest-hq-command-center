    "automations": [
      {
        "id": "a-short",
        "name": "Counted short — investigate",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-valuevariance",
          "op": "<",
          "value": "0"
        },
        "actions": [
          {
            "type": "notify",
            "message": "This count came up short against the system. List the items in Variances with a reason before adjusting any stock."
          }
        ]
      },
      {
        "id": "a-adjusted",
        "name": "Adjusted — update the products",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "cs-adjusted"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A count was adjusted. Make sure In stock on each product now matches what was counted."
          }
        ]
      },
      {
        "id": "a-theft",
        "name": "Theft suspected — tell the manager",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-reason",
          "value": "rs-theft"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A count was put down to theft. Tell the store manager and check whether the items need moving or securing."
          }
        ]
      }
    ],
