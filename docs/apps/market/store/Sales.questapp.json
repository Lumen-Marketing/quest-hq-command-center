      {
        "id": "f-marginpct",
        "label": "Margin %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Subtotal} - {Discount} - {Cost of goods}) * 100 / ({Subtotal} - {Discount})"
        }
