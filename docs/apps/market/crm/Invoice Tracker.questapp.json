    "automations": [
      {
        "id": "a-overdue",
        "name": "Overdue — follow up",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "iv-overdue"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-reminders",
            "value": "+1"
          },
          {
            "type": "notify",
            "message": "An invoice is overdue. Contact the client today and note any promise to pay."
          }
        ]
      },
      {
        "id": "a-disputed",
        "name": "Disputed — resolve before chasing",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "iv-disputed"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A client disputed an invoice. Stop reminders, find out what is wrong, and record the outcome in Notes."
          }
        ]
      },
      {
        "id": "a-paid",
        "name": "Paid — record the date",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "iv-paid"
        },
        "actions": [
          {
            "type": "notify",
            "message": "An invoice was marked Paid. Fill in the Paid on date and payment method."
          }
        ]
      }
