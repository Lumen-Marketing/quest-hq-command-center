        "id": "a-stalled",
        "name": "Stalled — find the blocker",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-stage",
          "to": "ob-stalled"
        },
        "actions": [
          {
            "type": "notify",
            "message": "An onboarding has stalled. Write down the blocker and agree a next step with the client this week."
          }
        ]
      },
      {
        "id": "a-live",
        "name": "Live — book the first check-in",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-stage",
          "to": "ob-live"
        },
        "actions": [
