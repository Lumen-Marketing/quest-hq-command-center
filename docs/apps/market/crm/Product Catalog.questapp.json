    "automations": [
      {
        "id": "a-low",
        "name": "Below reorder point — low stock",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-headroom",
          "op": "<",
          "value": "0"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-status",
            "value": "st-low"
          },
          {
            "type": "notify",
            "message": "A product dropped below its reorder point. Reorder it from the supplier."
          }
        ]
      },
      {
        "id": "a-out",
        "name": "Nothing left — out of stock",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-stock",
          "op": "<=",
          "value": "0"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-status",
            "value": "st-out"
          },
          {
            "type": "notify",
            "message": "A product is out of stock. Reorder it, or tell the team before they promise it to a client."
          }
        ]
      }
