      {
        "id": "f-left",
        "label": "Budget left",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Budget} - {Spent}) * {Budget} / {Budget}"
        }
      },
      {
        "id": "f-cpl",
        "label": "Cost per lead",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Spent} / {Leads}"
        }
      },
      {
        "id": "f-apptrate",
        "label": "Lead to appointment %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Appointments} * 100 / {Leads}"
        }
      },
      {
        "id": "f-close",
        "label": "Appointment to client %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Clients won} * 100 / {Appointments}"
        }
      },
      {
        "id": "f-cpc",
        "label": "Cost per client won",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Spent} / {Clients won}"
        }
      },
      {
        "id": "f-roi",
        "label": "Return on spend %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Revenue won} - {Spent}) * 100 / {Spent}"
        }
