    "automations": [
      {
        "id": "a-urgent",
        "name": "Urgent ticket — respond now",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-priority",
          "value": "pr-urgent"
        },
        "actions": [
          {
            "type": "notify",
            "message": "An urgent ticket came in. Reply to the client within the hour and assign it if nobody has it."
          }
        ]
      },
      {
        "id": "a-reopen",
        "name": "Reopened — count it",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "from": "ts-resolved",
          "to": "ts-open"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-reopened",
            "value": "+1"
          },
          {
            "type": "notify",
            "message": "A resolved ticket was reopened. Check what the first fix missed."
          }
        ]
      },
      {
        "id": "a-resolved",
        "name": "Resolved — check satisfaction",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "ts-resolved"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A ticket was resolved. Ask the client to confirm and record their satisfaction before closing it."
          }
        ]
      }
