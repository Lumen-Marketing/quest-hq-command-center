    "automations": [
      {
        "id": "a-noshow",
        "name": "No show — rebook",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "ap-noshow"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A client did not show up. Call or text today to rebook."
          }
        ]
      },
      {
        "id": "a-completed",
        "name": "Completed — record the outcome",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "ap-completed"
        },
        "actions": [
