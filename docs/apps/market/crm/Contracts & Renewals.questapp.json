    "automations": [
      {
        "id": "a-due",
        "name": "Renewal due — start the renewal steps",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "cs-due"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A contract is due for renewal. Review results with the client and send the renewal offer before the notice date."
          }
        ]
      },
      {
        "id": "a-expired",
        "name": "Expired — renew or close",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "cs-expired"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A contract has expired. Either send a renewal now or mark it Cancelled with a note explaining why."
          }
        ]
      },
      {
        "id": "a-renewed",
        "name": "Renewed — update the dates",
        "trigger": {
          "event": "stage_moves",
          "fieldId": "f-status",
          "to": "cs-renewed"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A contract was renewed. Update the start, end and notice dates and upload the signed renewal."
          }
        ]
      }
