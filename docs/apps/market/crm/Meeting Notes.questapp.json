    "automations": [
      {
        "id": "a-unhappy",
        "name": "Unhappy client — escalate",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-sentiment",
          "value": "se-unhappy"
        },
        "actions": [
          {
            "type": "notify",
            "message": "A client left a meeting unhappy. The account owner should follow up personally within a day."
          }
        ]
      },
      {
        "id": "a-concerned",
        "name": "Concerned client — follow up",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-sentiment",
          "value": "se-concerned"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-followup",
            "value": true
          },
          {
            "type": "notify",
            "message": "A client raised concerns in a meeting. A follow-up has been flagged."
          }
        ]
      },
      {
        "id": "a-followup",
        "name": "Follow-up needed — keep it open",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-followup",
          "value": true
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-status",
            "value": "mn-open"
          }
        ]
      }
    ],
