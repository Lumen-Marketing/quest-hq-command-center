    "automations": [
      {
        "id": "a-promoter",
        "name": "Score 9 or 10 — Promoter",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-score",
          "op": ">=",
          "value": "9"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-group",
            "value": "np-promoter"
          }
        ]
      },
      {
        "id": "a-passive7",
        "name": "Score 7 — Passive",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-score",
          "op": "==",
          "value": "7"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-group",
            "value": "np-passive"
          }
        ]
      },
      {
        "id": "a-passive8",
        "name": "Score 8 — Passive",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-score",
          "op": "==",
          "value": "8"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-group",
            "value": "np-passive"
          }
        ]
      },
      {
        "id": "a-detractor",
        "name": "Score 6 or below — Detractor",
        "trigger": {
          "event": "field_is",
          "fieldId": "f-score",
          "op": "<=",
          "value": "6"
        },
        "actions": [
          {
            "type": "set_field",
            "fieldId": "f-group",
            "value": "np-detractor"
          },
          {
            "type": "set_field",
            "fieldId": "f-status",
            "value": "fb-followup"
          },
          {
            "type": "notify",
            "message": "A client scored you 6 or below. Call them to understand what went wrong and set a Follow up by date."
          }
        ]
      }
    ],
