        "type": "number",
        "required": false,
        "hidden": false,
        "config": {
          "unit": "%",
          "placeholder": "The tier as a number the formulas can read"
        }
      },
      {
        "id": "f-quote",
        "label": "Quote price",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": "What the Closer takes to the customer"
        }
      },
      {
        "id": "f-profit",
        "label": "Gross profit",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Quote price} - ((({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) + ((({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) * ({Overhead %} + {Commission %} + {Contingency %}) / 100))"
        }
      },
      {
        "id": "f-live",
        "label": "Live margin %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Quote price} - ((({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) + ((({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) * ({Overhead %} + {Commission %} + {Contingency %}) / 100))) * 100 / {Quote price}"
        }
      },
      {
        "id": "f-vs",
        "label": "Margin vs target",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "(({Quote price} - ((({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) + ((({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) * ({Overhead %} + {Commission %} + {Contingency %}) / 100))) * 100 / {Quote price}) - {Target margin %}"
        }
      },
      {
        "id": "f-attarget",
        "label": "Price at target margin",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "((({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) + ((({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) * ({Overhead %} + {Commission %} + {Contingency %}) / 100)) * 100 / (100 - {Target margin %})"
        }
      },
