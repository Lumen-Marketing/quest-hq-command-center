      },
      {
        "id": "f-direct",
        "label": "Direct cost",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})"
        }
      },
      {
        "id": "f-burden",
        "label": "Overhead, commission & contingency",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "(({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) * ({Overhead %} + {Commission %} + {Contingency %}) / 100"
        }
      },
      {
        "id": "f-total",
        "label": "Total cost",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "(({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) + ((({Line items total} + ({Line items total} * {Tax %} / 100)) + ({Crew size} * {Days} * {Hours per day} * {Labor rate})) * ({Overhead %} + {Commission %} + {Contingency %}) / 100)"
        }
      },
