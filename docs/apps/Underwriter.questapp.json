              "color": "#d18a05"
            },
            {
              "id": "uw-decline",
              "label": "Reprice before approval",
              "color": "#c2413a"
            }
          ]
        }
      },
      {
        "id": "f-underwriter",
        "label": "Underwriter",
        "type": "user",
        "required": false,
        "hidden": false,
        "config": {}
      },
      {
        "id": "f-priced",
        "label": "Priced on",
        "type": "date",
        "required": false,
        "hidden": false,
        "config": {}
      },
      {
        "id": "f-price",
        "label": "Contract price",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": "What the customer pays"
        }
      },
      {
        "id": "f-target",
        "label": "Target margin %",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": {
          "unit": "%"
        }
      },
      {
        "id": "f-material",
        "label": "Material",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": ""
        }
      },
      {
        "id": "f-labor",
        "label": "Labor",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": ""
        }
      },
      {
        "id": "f-permits",
        "label": "Permits and fees",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": ""
        }
      },
      {
        "id": "f-disposal",
        "label": "Disposal",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": ""
        }
      },
      {
        "id": "f-other",
        "label": "Other direct cost",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": {
          "currency": "$",
          "placeholder": ""
        }
      },
      {
        "id": "f-overhead",
        "label": "Overhead %",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": {
          "unit": "%"
        }
      },
      {
        "id": "f-commission",
        "label": "Commission %",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": {
          "unit": "%"
        }
      },
      {
        "id": "f-contingency",
        "label": "Contingency %",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": {
          "unit": "%"
        }
      },
      {
        "id": "f-direct",
        "label": "Direct costs",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Material} + {Labor} + {Permits and fees} + {Disposal} + {Other direct cost})"
        }
      },
      {
        "id": "f-pctcost",
        "label": "Overhead, commission, contingency",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Contract price} * ({Overhead %} + {Commission %} + {Contingency %}) / 100"
        }
      },
      {
        "id": "f-total",
        "label": "Total cost",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Material} + {Labor} + {Permits and fees} + {Disposal} + {Other direct cost}) + {Contract price} * ({Overhead %} + {Commission %} + {Contingency %}) / 100"
        }
      },
      {
        "id": "f-profit",
        "label": "Gross profit",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Contract price} - (({Material} + {Labor} + {Permits and fees} + {Disposal} + {Other direct cost}) + {Contract price} * ({Overhead %} + {Commission %} + {Contingency %}) / 100)"
        }
      },
      {
        "id": "f-margin",
        "label": "Gross margin %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Contract price} - (({Material} + {Labor} + {Permits and fees} + {Disposal} + {Other direct cost}) + {Contract price} * ({Overhead %} + {Commission %} + {Contingency %}) / 100)) * 100 / {Contract price}"
        }
      },
      {
        "id": "f-gap",
        "label": "Margin gap",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "(({Contract price} - (({Material} + {Labor} + {Permits and fees} + {Disposal} + {Other direct cost}) + {Contract price} * ({Overhead %} + {Commission %} + {Contingency %}) / 100)) * 100 / {Contract price}) - {Target margin %}"
        }
      },
      {
        "id": "f-maxdirect",
        "label": "Max direct cost at target",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "{Contract price} * (100 - ({Overhead %} + {Commission %} + {Contingency %}) - {Target margin %}) / 100"
        }
      },
      {
        "id": "f-headroom",
        "label": "Direct cost headroom",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Contract price} * (100 - ({Overhead %} + {Commission %} + {Contingency %}) - {Target margin %}) / 100) - ({Material} + {Labor} + {Permits and fees} + {Disposal} + {Other direct cost})"
        }
      },
      {
        "id": "f-breakeven",
        "label": "Break-even price",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": {
          "formula": "({Material} + {Labor} + {Permits and fees} + {Disposal} + {Other direct cost}) * 100 / (100 - ({Overhead %} + {Commission %} + {Contingency %}))"
        }
      },
      {
        "id": "f-notes",
        "label": "Decision notes",
        "type": "textarea",
        "required": false,
        "hidden": false,
        "config": {
          "placeholder": "Scope risks, exclusions, or pricing decision"
        }
      },
      {
        "id": "f-docs",
        "label": "Scope & carrier docs",
        "type": "file",
        "required": false,
        "hidden": false,
        "config": {
          "multiple": true
        }
      }
    ],
    "items": [],
    "automations": [],
