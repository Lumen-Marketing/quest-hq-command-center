    "automations": [
      {
        "id": "a-won",
        "name": "Won — arm the draws and split the jobs",
        "trigger": { "event": "stage_moves", "fieldId": "f-stage", "to": "pp-won" },
        "actions": [
          {
            "type": "notify",
            "message": "Signed. Each accepted scope becomes its own job with its draws armed and its buckets pre-loaded. Work the Handoff at signature checklist — it is the step, not a button."
          }
        ]
      },
      {
        "id": "a-partial",
        "name": "Partially won — only the signed trades travel",
        "trigger": { "event": "stage_moves", "fieldId": "f-stage", "to": "pp-partial" },
        "actions": [
          {
            "type": "notify",
            "message": "A partial signing. Only scopes with Signed ticked become jobs; the rest are closed or sent back to be re-quoted. The proposal stays open on this record."
          }
        ]
      }
    ],
    "cardFields": ["f-contact", "f-price", "f-signed", "f-stage"],
