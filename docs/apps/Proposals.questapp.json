{
  "format": "quest-hq-app",
  "version": 1,
  "exported_at": "2026-08-17T00:00:00.000Z",
  "app": {
    "name": "Proposals",
    "recordName": "Proposal",
    "type": "Sales",
    "icon": "ti-file-signature",
    "color": "#7c3aed",
    "description": "The document the client signs, sitting ABOVE the per-trade deals rather than replacing them. One deal is one trade, so a lump sum wrapped across three trades had nowhere to live and a partial signing had to be inferred from which deals went Lost. Scopes is the list of trades this document covers — each with its own Signed tick — so a partial signing is recorded on the thing that was signed, and Partially won is a stage of its own. Two limits are shown rather than papered over: Contract price is TYPED, because a calculation resolves {Label} against the app's fields and never a sub-item list, and there is no per-record rollup over a collection; and \"the draw schedule must total 100%\" is shown by Draw total %, not enforced, because the formula grammar has no conditional. There is deliberately no hand-off button — one press creates one record, and the handoff fans out to one job per SIGNED trade, so a single button would file one job carrying no trade and read as working. The checklist carries the step instead.",
    "fields": [
      {
        "id": "f-proposal",
        "label": "Proposal",
        "type": "text",
        "required": true,
        "hidden": false,
        "config": { "placeholder": "Henderson — 58th Pl" }
      },
      {
        "id": "f-no",
        "label": "Proposal #",
        "type": "autonumber",
        "required": false,
        "hidden": false,
        "config": { "prefix": "PR-", "padding": 4 }
      },
      {
        "id": "f-contact",
        "label": "Contact",
        "type": "company_contact",
        "required": true,
        "hidden": false,
        "config": {}
      },
      {
        "id": "f-company",
        "label": "Company",
        "type": "text",
        "required": false,
        "hidden": false,
        "config": { "placeholder": "If they are not a homeowner" }
      },
      {
        "id": "f-project",
        "label": "Project",
        "type": "text",
        "required": false,
        "hidden": false,
        "config": { "placeholder": "The project these trades belong to" }
      },
      {
        "id": "f-address",
        "label": "Address",
        "type": "location",
        "required": false,
        "hidden": false,
        "config": {}
      },
      {
        "id": "f-stage",
        "label": "Stage",
        "type": "status",
        "required": false,
        "hidden": false,
        "config": {
          "options": [
            { "id": "pp-draft", "label": "Draft", "color": "#64748b" },
            { "id": "pp-sent", "label": "Sent", "color": "#378ADD" },
            { "id": "pp-neg", "label": "Negotiating", "color": "#BA7517" },
            { "id": "pp-partial", "label": "Partially won", "color": "#d97706" },
            { "id": "pp-won", "label": "Won", "color": "#639922" },
            { "id": "pp-lost", "label": "Lost", "color": "#E24B4A" }
          ]
        }
      },
      {
        "id": "f-closer",
        "label": "Closer",
        "type": "user",
        "required": false,
        "hidden": false,
        "config": {}
      },
      {
        "id": "f-type",
        "label": "Proposal type",
        "type": "category",
        "required": false,
        "hidden": false,
        "config": {
          "options": [
            { "id": "pt-lump", "label": "Lump sum", "color": "#2563eb" },
            { "id": "pt-split", "label": "Split per scope", "color": "#7c3aed" }
          ]
        }
      },
      {
        "id": "f-price",
        "label": "Contract price",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": { "currency": "$", "placeholder": "The one number the client signs" }
      },
      {
        "id": "f-cost",
        "label": "Cost",
        "type": "money",
        "required": false,
        "hidden": false,
        "config": { "currency": "$", "placeholder": "Total from the underwriting sheets" }
      },
      {
        "id": "f-profit",
        "label": "Gross profit",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": { "formula": "{Contract price} - {Cost}" }
      },
      {
        "id": "f-margin",
        "label": "Gross margin %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": { "formula": "({Contract price} - {Cost}) * 100 / {Contract price}" }
      },
      {
        "id": "f-d1",
        "label": "Draw 1 %",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": { "unit": "%" }
      },
      {
        "id": "f-d2",
        "label": "Draw 2 %",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": { "unit": "%" }
      },
      {
        "id": "f-d3",
        "label": "Draw 3 %",
        "type": "number",
        "required": false,
        "hidden": false,
        "config": { "unit": "%" }
      },
      {
        "id": "f-dtotal",
        "label": "Draw total %",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": { "formula": "({Draw 1 %} + {Draw 2 %} + {Draw 3 %})" }
      },
      {
        "id": "f-d1amt",
        "label": "Draw 1 amount",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": { "formula": "{Contract price} * {Draw 1 %} / 100" }
      },
      {
        "id": "f-d2amt",
        "label": "Draw 2 amount",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": { "formula": "{Contract price} * {Draw 2 %} / 100" }
      },
      {
        "id": "f-d3amt",
        "label": "Draw 3 amount",
        "type": "calculation",
        "required": false,
        "hidden": false,
        "config": { "formula": "{Contract price} * {Draw 3 %} / 100" }
      },
