        { "id": "c2", "label": "Designer", "color": "#7c3aed" },
        { "id": "c3", "label": "Marketer", "color": "#e0552d" },
        { "id": "c4", "label": "Sales", "color": "#16a34a" },
        { "id": "c5", "label": "Operations", "color": "#0891b2" }
      ] } },
