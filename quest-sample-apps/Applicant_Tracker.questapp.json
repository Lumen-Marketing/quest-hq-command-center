        { "id": "s2", "label": "Screening", "color": "#d97706" },
        { "id": "s3", "label": "Interview", "color": "#2563eb" },
        { "id": "s4", "label": "Offer", "color": "#7c3aed" },
        { "id": "s5", "label": "Hired", "color": "#16a34a" },
        { "id": "s6", "label": "Rejected", "color": "#dc2626" }
      ] } },
      { "id": "f4", "label": "Interview Checklist", "type": "checklist", "required": false, "hidden": false, "config": { "steps": ["Phone screen", "Technical round", "Culture fit", "References checked", "Offer sent"] } },
      { "id": "f5", "label": "Pipeline Progress", "type": "progress", "required": false, "hidden": false, "config": { "source": "f4", "display": "bar", "colorMode": "single", "color": "#0891b2" } },
      { "id": "f6", "label": "Rating", "type": "number", "required": false, "hidden": false, "config": { "unit": "/ 5" } },
      { "id": "f7", "label": "Expected Salary", "type": "money", "required": false, "hidden": false, "config": { "currency": "$" } },
      { "id": "f8", "label": "Email", "type": "email", "required": false, "hidden": false, "config": {} },
      { "id": "f9", "label": "Phone", "type": "phone", "required": false, "hidden": false, "config": {} },
      { "id": "f10", "label": "Applied On", "type": "date", "required": false, "hidden": false, "config": {} },
      { "id": "f11", "label": "Notes", "type": "textarea", "required": false, "hidden": true, "config": { "placeholder": "Strengths, concerns, next step" } },
      { "id": "f12", "label": "Hired", "type": "checkbox", "required": false, "hidden": false, "config": {} }
