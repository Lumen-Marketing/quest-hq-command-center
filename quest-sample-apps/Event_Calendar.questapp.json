      { "id": "f7", "label": "Location", "type": "location", "required": false, "hidden": false, "config": {} },
      { "id": "f8", "label": "Host", "type": "text", "required": false, "hidden": false, "config": { "placeholder": "Owner / organizer" } },
      { "id": "f9", "label": "Prep Checklist", "type": "checklist", "required": false, "hidden": false, "config": { "steps": ["Book venue / room", "Send invites", "Confirm speakers", "Prepare materials", "Tech check", "Reminder sent"] } },
      { "id": "f10", "label": "Readiness", "type": "progress", "required": false, "hidden": false, "config": { "source": "f9", "display": "ring", "colorMode": "scale", "stops": [
