      { "id": "f12", "label": "Budget", "type": "money", "required": false, "hidden": false, "config": { "currency": "$" } },
      { "id": "f13", "label": "Contact / RSVP", "type": "email", "required": false, "hidden": false, "config": {} },
      { "id": "f14", "label": "Notes", "type": "textarea", "required": false, "hidden": true, "config": { "placeholder": "Agenda, links, logistics" } },
