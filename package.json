{
  "name": "quest-hq-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.mjs",
    "build:icons": "node scripts/build-icon-subset.mjs && node scripts/build-icon-packs.mjs",
    "build": "vite build && node scripts/sync-spa-assets.mjs dist && node scripts/check-bundle-budget.mjs dist && node scripts/check-bundle-boots.mjs dist",
    "ai:check": "node scripts/check-ai-context.mjs",
    "check": "npm test && npm run ai:check && npm run tenancy:check && npm run build",
    "clean:check": "node scripts/check-clean-tree.mjs",
    "deploy:prod": "npm run clean:check && npm run check && npx vercel --prod --yes",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:prod": "node scripts/production-smoke.mjs",
    "tenancy:check": "node scripts/check-tenancy-matrix.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.2.108"
  },
  "devDependencies": {
    "@phosphor-icons/web": "2.1.2",
    "lucide-static": "1.28.0",
    "material-icons": "1.13.14",
    "remixicon": "4.9.1",
    "vite": "^7.3.6"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "nanoid": "^3.3.18"
  }
}
