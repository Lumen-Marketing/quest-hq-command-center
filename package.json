{
  "name": "quest-hq-command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --test tests/*.mjs",
    "build:icons": "node scripts/build-icon-subset.mjs",
    "build": "vite build && node scripts/sync-spa-assets.mjs dist && node scripts/check-bundle-budget.mjs dist",
    "ai:check": "node scripts/check-ai-context.mjs",
    "check": "npm test && npm run ai:check && npm run build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:prod": "node scripts/production-smoke.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "pdfjs-dist": "^6.1.200"
  },
  "devDependencies": {
    "vite": "^7.3.6"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
